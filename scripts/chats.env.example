# Chats container cron — copy to scripts/chats.env (gitignored) and fill in.
# The private POSTING key never leaves the server and is never committed.

CHATS_ACCOUNT=changeme            # existing BBH-controlled Hive account
CHATS_POSTING_KEY=changeme        # that account's PRIVATE posting key (WIF, starts 5...)
CHATS_CONTAINER_PREFIX=bbh-chats- # must match config.js CHATS_CONTAINER_PREFIX
CHATS_TAG=bbh-chat
CHATS_APP=bbhproject
HIVE_NODE=https://api.hive.blog
