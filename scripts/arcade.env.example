# Bee Invaders arcade — payout secrets. Copy the two vars below into the app's
# gitignored .env (NOT a separate file — runtimeConfig reads the app .env at build),
# then rebuild. Never commit real values.

# BBHBot's Hive ACTIVE key — signs the weekly prize + burn transfers from the pot
# account. Same key the tipping bot uses. Server-only (runtimeConfig.bbhbotActiveKey).
BBHBOT_ACTIVE_KEY=

# Shared secret the payout trigger (scripts/arcade-payout.sh / systemd timer)
# presents in the x-arcade-admin header. Generate: openssl rand -hex 32
ARCADE_ADMIN_TOKEN=
